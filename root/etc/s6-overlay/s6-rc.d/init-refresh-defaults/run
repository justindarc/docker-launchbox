#!/bin/bash
LABWC_CONFIG_DIR="/config/.config/labwc"
OPENBOX_CONFIG_DIR="/config/.config/openbox"
mkdir -p "$LABWC_CONFIG_DIR"
mkdir -p "$OPENBOX_CONFIG_DIR"
cp /defaults/autostart_wayland "$LABWC_CONFIG_DIR/autostart"
cp /defaults/autostart "$OPENBOX_CONFIG_DIR/autostart"
cp /defaults/labwc.xml "$LABWC_CONFIG_DIR/rc.xml"
cp /defaults/menu_wayland.xml "$LABWC_CONFIG_DIR/menu.xml"
cp /defaults/menu.xml "$OPENBOX_CONFIG_DIR/menu.xml"
chmod +x "$LABWC_CONFIG_DIR/autostart"
chmod +x "$OPENBOX_CONFIG_DIR/autostart"
chown -R abc:abc "$LABWC_CONFIG_DIR"
chown -R abc:abc "$OPENBOX_CONFIG_DIR"
